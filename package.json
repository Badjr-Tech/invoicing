    "@react-pdf/renderer": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@vercel/analytics": "^1.3.1",
    "@vercel/blob": "^0.23.4",
    "@vercel/postgres": "^0.9.0",
    "autoprefixer": "^10.4.22",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.31.2",
    "jose": "^5.6.3",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.400.0",
    "next": "^16.0.10",
    "react": "18.2.0",
